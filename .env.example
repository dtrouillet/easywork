# Copy to .env — never commit .env

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/easywork
SPRING_DATASOURCE_USERNAME=easywork
SPRING_DATASOURCE_PASSWORD=changeme

# OIDC / Keycloak
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://localhost:8180/realms/easywork
# Only needed if issuer-uri above isn't reachable from wherever this backend
# runs (e.g. Docker Compose, where the browser reaches Keycloak via localhost
# but the backend container must use the Keycloak service name) — otherwise
# leave unset.
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=easywork-documents

# RabbitMQ
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# OCR — path depends on the tesseract-ocr package's install layout on your
# OS/base image; this matches the runtime-ocr Docker image (Ubuntu Jammy).
TESSDATA_PATH=/usr/share/tesseract-ocr/4.00/tessdata
OCR_LANGUAGES=fra+eng

# CORS — comma-separated list of allowed frontend origins (no trailing slash, no wildcard)
CORS_ALLOWED_ORIGINS=https://app.example.com

# Frontend
NEXTAUTH_SECRET=changeme
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

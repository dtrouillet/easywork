# Copy to .env — never commit .env

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/easywork
SPRING_DATASOURCE_USERNAME=easywork
SPRING_DATASOURCE_PASSWORD=changeme

# OIDC / Keycloak
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://localhost:8080/realms/easywork

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=easywork-documents

# RabbitMQ
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# OCR
TESSDATA_PATH=/usr/share/tessdata
OCR_LANGUAGES=fra+eng

# Frontend
NEXTAUTH_SECRET=changeme
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

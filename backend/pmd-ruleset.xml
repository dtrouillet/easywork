<?xml version="1.0"?>
<ruleset name="easywork-custom"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>
        Curated PMD ruleset for easywork, adapted from the bestpractices,
        errorprone and design categories. Excludes rules that conflict with
        this project's stack rather than forcing an unrelated refactor:
        Lombok-generated JPA entities are inherently "data classes" with many
        fields/getters, fluent/getter-chain code triggers LawOfDemeter noise,
        tests legitimately assert several related facts per case, and
        Testcontainers base test classes / @SpringBootApplication entrypoints
        are idiomatically "abstract with no abstract methods" / "utility-like".
    </description>

    <rule ref="category/java/bestpractices.xml">
        <exclude name="GuardLogStatement"/>
        <exclude name="UnitTestContainsTooManyAsserts"/>
        <exclude name="AbstractClassWithoutAbstractMethod"/>
    </rule>

    <rule ref="category/java/errorprone.xml">
        <exclude name="MissingSerialVersionUID"/>
        <exclude name="AvoidDuplicateLiterals"/>
    </rule>

    <rule ref="category/java/design.xml">
        <exclude name="LawOfDemeter"/>
        <exclude name="DataClass"/>
        <exclude name="TooManyFields"/>
        <exclude name="ExcessivePublicCount"/>
        <exclude name="ExcessiveImports"/>
        <exclude name="TooManyMethods"/>
        <exclude name="SignatureDeclareThrowsException"/>
        <exclude name="AvoidCatchingGenericException"/>
        <exclude name="UseUtilityClass"/>
        <exclude name="CyclomaticComplexity"/>
        <exclude name="NPathComplexity"/>
    </rule>

    <!-- Slightly relaxed thresholds instead of a blanket exclude, to keep
         complexity signal for future code without flagging existing methods. -->
    <rule ref="category/java/design.xml/CyclomaticComplexity">
        <properties>
            <property name="methodReportLevel" value="11"/>
        </properties>
    </rule>
    <rule ref="category/java/design.xml/NPathComplexity">
        <properties>
            <property name="reportLevel" value="300"/>
        </properties>
    </rule>
</ruleset>
